{
  "name": "dm-empresarial",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma digital de autoridade da DM Empresarial",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "db:down": "docker compose --env-file .env.local down",
    "db:check": "node --env-file=.env.local scripts/db-check.mts",
    "db:bootstrap": "node --env-file-if-exists=.env.local scripts/db-bootstrap.mts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.mts",
    "admin:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-admin.mts",
    "db:setup": "npm run db:bootstrap && npm run db:migrate && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "db:verify": "drizzle-kit check",
    "prepare": "git config core.hooksPath .githooks || true",
    "db:setup:remote": "node --env-file=.env.neon scripts/db-bootstrap.mts && node --env-file=.env.neon scripts/db-migrate.mts && node --env-file=.env.neon scripts/db-seed.mts",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup-restore.mts backup",
    "db:restore": "node --env-file-if-exists=.env.local scripts/backup-restore.mts restore"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "file-type": "22.1.1",
    "next": "16.3.5",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "lighthouse": "13.5.0",
    "lighthouse-ci": "1.13.1",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "web-vitals": "6.2.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
