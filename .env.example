# =============================================================================
# DM Empresarial — Variáveis de Ambiente (EXEMPLO)
# Copie para .env.local e preencha com valores REAIS. NUNCA commite .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------
# Ambiente: development | test | staging | production
# OBRIGATÓRIO em production: deve ser explícito (não usa padrão)
APP_ENV=development

# URL pública do site (sem barra final). OBRIGATÓRIO em production, deve usar https.
SITE_URL=http://localhost:3000

# Nível de log: error | warn | info | debug
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# -----------------------------------------------------------------------------
# Role de aplicação (dm_app): runtime, sem DDL. OBRIGATÓRIO em production.
# Ex: postgresql://dm_app:senha@host:5432/dm_empresarial?sslmode=require
DATABASE_URL=

# Role de dono (dm_owner): migrations/bootstrap. OBRIGATÓRIO em production.
# Ex: postgresql://dm_owner:senha@host:5432/dm_empresarial?sslmode=require
DATABASE_URL_ADMIN=

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO (Better Auth)
# -----------------------------------------------------------------------------
# Segredo de assinatura das sessões (mínimo 32 chars). OBRIGATÓRIO em production.
# Gere com: openssl rand -base64 48
BETTER_AUTH_SECRET=

# URL base da autenticação. Se ausente, usa SITE_URL.
BETTER_AUTH_URL=

# 2FA obrigatório para ADMIN/EDITOR. Padrão: true. NÃO desligue em production (decisão T-05).
REQUIRE_2FA=true

# -----------------------------------------------------------------------------
# SEGURANÇA
# -----------------------------------------------------------------------------
# Segredo do cron de publicação agendada (/api/cron/publish). Mínimo 32 chars.
CRON_SECRET=

# Segredo para tokens assinados (confirmação newsletter, descadastro). Mínimo 32 chars.
SIGNED_TOKEN_SECRET=

# Chave de criptografia de Server Actions (só para multi-instância).
# Gere com: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# STORAGE (S3-compatível: AWS S3, Cloudflare R2, MinIO...)
# -----------------------------------------------------------------------------
# local | s3. Vazio: s3 se houver STORAGE_BUCKET etc., senão local (pasta STORAGE_LOCAL_DIR).
# Em production é obrigatório escolher: na Vercel o disco é efêmero, use s3.
STORAGE_DRIVER=

# O bucket pode ser PRIVADO: os arquivos são servidos pelo próprio site em /media/...
# Ex. R2: https://<conta>.r2.cloudflarestorage.com · AWS: https://s3.us-east-1.amazonaws.com
STORAGE_ENDPOINT=

# Nome do bucket
STORAGE_BUCKET=

# Access Key ID
STORAGE_ACCESS_KEY_ID=

# Secret Access Key
STORAGE_SECRET_ACCESS_KEY=

# Região: "auto" no R2 (padrão); na AWS, a região do bucket.
STORAGE_REGION=

# -----------------------------------------------------------------------------
# E-MAIL (Resend) — obrigatório em production. Sem os dois, os e-mails só vão para o log.
# -----------------------------------------------------------------------------
# Remetente verificado no Resend. Ex: DM Empresarial <contato@dm.empresarial.com>
EMAIL_FROM=

# API Key do Resend (re_...)
RESEND_API_KEY=

# Destinatário do aviso de lead novo. Vazio: usa o e-mail público de Configurações.
LEAD_NOTIFY_TO=

# -----------------------------------------------------------------------------
# ANALYTICS (opcional, futuro)
# -----------------------------------------------------------------------------
# ANALYTICS_...

# -----------------------------------------------------------------------------
# RECURSOS
# -----------------------------------------------------------------------------
# Reservado (sem efeito ainda): atribuição first-touch por cookie, desligada até parecer
# jurídico (docs/03 §15). As colunas de origem do lead já existem no banco.
ATTRIBUTION_ENABLED=false